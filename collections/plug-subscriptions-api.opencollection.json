        {
          "info": {
            "name": "Listar cycles de uma assinatura",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.malga.io/v1/subscriptions/:id/cycles",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id da assinatura"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Número máximo de items por página"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Número da página"
              }
            ]
          },
          "docs": "Listar cycles de uma assinatura"
        },
        {
          "info": {
            "name": "Recuperar detalhes de um cycle específico",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.malga.io/v1/subscriptions/:id/cycles/:cycleId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id da assinatura"
              },
              {
                "name": "cycleId",
                "value": "",
                "type": "path",
                "description": "Id do cycle"
              }
            ]
          },
          "docs": "Recuperar detalhes de um cycle específico"
        },
        {
          "info": {
            "name": "Obter configurações do cliente",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.malga.io/v1/subscriptions/settings"
          },
          "docs": "Recupera as configurações atuais do cliente para assinaturas (retry policy, statement descriptor, etc.)"
        },
        {
          "info": {
            "name": "Atualizar configurações do cliente",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.malga.io/v1/subscriptions/settings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Atualiza as configurações do cliente para assinaturas (retry policy, statement descriptor, etc.)"
        }
      ]
    }
  ],
  "bundled": true
}
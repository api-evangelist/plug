                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Tipo do documento (This can only be one of SELFIE,CNH_FULL,CNH_FRONT,CNH_BACK,RG_FRONT,RG_BACK)"
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) Arquivo do documento"
                }
              ]
            }
          },
